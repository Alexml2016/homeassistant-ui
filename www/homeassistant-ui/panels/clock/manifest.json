{
  "name": "Home Assistant Clock Panel",
  "version": "2.3.0",
  "description": "Fullscreen seven-segment clock panel with armed mode, doorbell camera view, and courtyard gate open control",
  "entrypoint": "src/clock-panel.js",
  "home_assistant": {
    "panel_name": "clock-panel",
    "url_path": "clock-screen"
  },
  "entities": {
    "alarm": "binary_sensor.alarm_gateway_alarm_relay_state",
    "weather": "weather.home_assistant",
    "doorbell": "binary_sensor.doorbell_button",
    "camera": "camera.doorbell",
    "door_switch": "switch.ulitsa_courtyard_kalitka"
  }
}
